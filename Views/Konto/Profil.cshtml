<!-- Strona edycji profilu użytkownika -->
@model PortalWydarzenLokalnych.Models.Uzytkownik

@{
    ViewData["Title"] = "Mój profil";
}

<h2>Mój profil</h2>

@if (ViewBag.Sukces != null)
{
    <div class="alert alert-success">@ViewBag.Sukces</div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var blad in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p>@blad.ErrorMessage</p>
        }
    </div>
}

<form method="post">
    <div class="mb-3">
        <label>Imię</label>
        <input type="text" name="imie" value="@Model.Imie" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Nazwisko</label>
        <input type="text" name="nazwisko" value="@Model.Nazwisko" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Email</label>
        <input type="email" name="email" value="@Model.Email" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Data rejestracji</label>
        <input type="text" value="@Model.DataRejestracji.ToString("dd.MM.yyyy")" class="form-control" disabled />
    </div>
    <button type="submit" class="btn btn-primary">Zapisz zmiany</button>
    <a href="/" class="btn btn-secondary ms-2">Anuluj</a>
</form>