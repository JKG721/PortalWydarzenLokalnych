<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portal wydarzeń lokalnych</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <!-- Nawigacja -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="/">🗓️ Portal wydarzeń</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Strona główna</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Wydarzenia">Wydarzenia</a>
                    </li>
                    <!-- Linki admina widoczne tylko dla roli Admin -->
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Panel admina</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/AdminWydarzenia">Wydarzenia</a></li>
                                <li><a class="dropdown-item" href="/AdminKategorie">Kategorie</a></li>
                                <li><a class="dropdown-item" href="/AdminUzytkownicy">Użytkownicy</a></li>
                            </ul>
                        </li>
                    }
                </ul>
                <!-- Logowanie / wylogowanie -->
                <ul class="navbar-nav">
                    @if (User.Identity!.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-white">Cześć, @User.Identity.Name!</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Konto/Wylogowanie">Wyloguj</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Konto/Logowanie">Zaloguj się</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Konto/Rejestracja">Rejestracja</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Główna treść -->
    <div class="container mt-4">
        @RenderBody()
    </div>

    <!-- Stopka -->
    <footer class="bg-light mt-5 py-3 text-center text-muted">
        <p>© @DateTime.Now.Year Portal wydarzeń lokalnych</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>