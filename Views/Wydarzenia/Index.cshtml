<!-- Lista wszystkich wydarzeń z filtrami -->
@model List<PortalWydarzenLokalnych.Models.Wydarzenie>

@{
    ViewData["Title"] = "Wydarzenia";
}

<h2>Wydarzenia</h2>

<!-- Filtry wyszukiwania -->
<form method="get" class="mb-4">
    <div class="row g-2">
        <div class="col-md-3">
            <input type="text" name="szukaj" value="@ViewBag.SzukajFraza"
                   class="form-control" placeholder="Szukaj wydarzeń..." />
        </div>
        <div class="col-md-3">
            <select name="kategoriaId" class="form-control">
                <option value="">-- Wszystkie kategorie --</option>
                @foreach (var k in ViewBag.Kategorie)
                {
                    <option value="@k.Id">@k.Nazwa</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <input type="date" name="dataOd" value="@ViewBag.DataOd"
                   class="form-control" placeholder="Data od" />
        </div>
        <div class="col-md-2">
            <input type="date" name="dataDo" value="@ViewBag.DataDo"
                   class="form-control" placeholder="Data do" />
        </div>
        <div class="col-md-2">
            <select name="sortuj" class="form-control">
                <option value="">-- Sortuj --</option>
                <option value="data">Data rosnąco</option>
                <option value="data_desc">Data malejąco</option>
                <option value="nazwa">Nazwa A-Z</option>
                <option value="nazwa_desc">Nazwa Z-A</option>
            </select>
        </div>
    </div>
    <div class="row mt-2">
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Szukaj</button>
        </div>
        <div class="col-md-2">
            <a href="/Wydarzenia" class="btn btn-secondary w-100">Wyczyść</a>
        </div>
    </div>
</form>

<!-- Lista wydarzeń -->
@if (Model.Count == 0)
{
    <p>Nie znaleziono wydarzeń.</p>
}
else
{
    <div class="row">
        @foreach (var wydarzenie in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(wydarzenie.ZdjecieSciezka))
                    {
                        <img src="@wydarzenie.ZdjecieSciezka" class="card-img-top" style="height: 200px; object-fit: cover;" />
                    }
                    else
                    {
                        <img src="https://placehold.co/400x200?text=Brak+zdjecia" class="card-img-top" style="height: 200px; object-fit: cover;" />
                    }
                    <div class="card-body">
                        <h5 class="card-title">@wydarzenie.Nazwa</h5>
                        <p class="card-text text-muted">
                             @wydarzenie.DataRozpoczecia.ToString("dd.MM.yyyy HH:mm")
                        </p>
                        <p class="card-text text-muted">
                             @wydarzenie.Lokalizacja
                        </p>
                        <span class="badge bg-secondary">@wydarzenie.Kategoria?.Nazwa</span>
                        <!-- Licznik zapisanych -->
                        <span class="badge bg-info ms-1">👥 @wydarzenie.Zapisy.Count / @wydarzenie.MaksUczestnikow</span>
                    </div>
                    <div class="card-footer">
                        <a href="/Wydarzenia/Szczegoly/@wydarzenie.Id" class="btn btn-primary btn-sm">Zobacz szczegóły</a>
                    </div>
                </div>
            </div>
        }
    </div>
}